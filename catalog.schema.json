{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Copado Agent Skills Catalog",
  "type": "object",
  "required": ["catalogVersion", "owner", "skills"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "catalogVersion": { "type": "integer", "minimum": 1 },
    "owner": {
      "type": "object",
      "required": ["github", "continuity"],
      "additionalProperties": false,
      "properties": {
        "github": { "type": "string", "minLength": 1 },
        "continuity": { "type": "string", "minLength": 1 }
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "version", "path", "owners", "compatibility", "releaseTag"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
          "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
          "path": { "type": "string", "pattern": "^skills/[a-z0-9][a-z0-9-]*$" },
          "owners": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "compatibility": {
            "type": "object",
            "required": ["cursor", "claudeCode", "agentSkills"],
            "properties": {
              "cursor": { "type": "boolean" },
              "claudeCode": { "type": "boolean" },
              "agentSkills": { "const": "portable" }
            }
          },
          "releaseTag": { "type": "string" }
        }
      }
    }
  }
}
